# Web mặc định dùng API DEV thật. Đổi thành mock chỉ khi cần phát triển offline.
NEXT_PUBLIC_IOTX_MODE=iotx

# Trình duyệt gọi same-origin /v1; Next.js proxy sang API DEV để tránh CORS.
NEXT_PUBLIC_IOTX_API_BASE=/v1
NEXT_PUBLIC_IOTX_TENANT=livotec
NEXT_PUBLIC_IOTX_LANG=vi
IOTX_API_UPSTREAM=https://api.dev.happibot.net

# Hiện nguyên nhân thật khi proxy /v1 không với tới IBS (tên máy, cổng, lỗi DNS/TLS).
# Chỉ bật khi đang chẩn đoán trên máy nội bộ. KHÔNG bật ở môi trường thật.
IOTX_HIEN_LOI_PROXY=0
